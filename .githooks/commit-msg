#!/bin/sh
set -eu

message_file=$1
header=$(sed -n '1p' "$message_file")

if [ ${#header} -gt 72 ]; then
    echo "commit header exceeds 72 characters" >&2
    exit 1
fi

pattern='^(feat|fix|perf|refactor)(\([a-z0-9][a-z0-9/-]*\))!?\: [a-z0-9].*[^.]$|^(docs|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9/-]*\))!?\: [a-z0-9].*[^.]$'
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
    echo "invalid Conventional Commit header: $header" >&2
    exit 1
fi

